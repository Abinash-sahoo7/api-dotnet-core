## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (Rider)
.idea/
*.sln.iml

# MonoDevelop
*.userprefs

# ASP.NET Core specific
appsettings.Development.json
appsettings.Local.json
appsettings.*.json

# Log files
*.log

# Environment variables
.env

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]uild/
[Bb]in/
[Oo]bj/
[Ll]og/

# .NET Core artifacts
project.lock.json
project.fragment.lock.json
artifacts/

# Generated files
Generated/
Generated_Code/

# Publish output
publish/
out/

# NuGet packages
*.nupkg
# NuGet v3 package folders
*.nuget/
packages/
# NuGet Symbol Packages
*.snupkg

# Visual Studio cache files
.vs/
.vscode/

# Rider cache
.idea/

# IIS Express
iisexpress/
*.vspscc

# SQL Server files
*.mdf
*.ldf

# Test results
TestResults/
*.trx
*.coverage
*.coverlet.json
coverage/

# Resharper
_ReSharper*/
*.DotSettings.user

# dotCover
.idea/.idea.DotSettings

# Backup & crash files
*.bak
*.old
*.orig

# Docker
docker-compose.override.yml
*.pid

# Node (if using frontend in same repo)
node_modules/
npm-debug.log*
yarn-error.log*

# Others
*.swp
*~
*.tmp
*.temp
*.DS_Store

# JetBrains Rider specific
.idea/
*.sln.iml

